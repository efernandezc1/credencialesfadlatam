---
import Panel from '../ui/Panel.astro';
---

<Panel id="gestion" class="scene" transition="iris" bgIntensity={3}>
  <div class="wrap">
    <div class="ge-grid">
      <div>
        <h2 class="ge-title fx-words">Gestión asistida, alertas y optimización con IA</h2>
        <div class="ge-bar"></div>
        <p class="ge-text">Integramos inteligencia artificial en la operación diaria: auditamos las campañas de forma continua, detectamos variaciones de rendimiento antes de que impacten los resultados y ajustamos pujas y presupuestos con criterio estratégico.</p>
        <div class="ge-pills">
          <div class="ge-pill rv">Análisis</div>
          <div class="ge-pill rv">Alertas</div>
          <div class="ge-pill rv">Optimización</div>
        </div>
      </div>
      <div class="ge-mocks">
        <figure class="gm gm-shot rv">
          <img
            src="/images/gestion-meta-vv.png"
            alt="Dashboard Meta Ads · V&amp;V — leads, CPL e inversión"
            width="2048"
            height="1030"
            loading="eager"
            decoding="async"
          />
        </figure>
        <figure class="gm gm-shot rv">
          <img
            src="/images/gestion-google-vv.png"
            alt="Resumen del mes Google Ads · Pitch V&amp;V"
            width="2048"
            height="970"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</Panel>
