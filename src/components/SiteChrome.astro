---
import { SCENE_COUNT } from '../data/scenes';
import SideMenu from './SideMenu.astro';
---

<div id="page-bg" aria-hidden="true"></div>
<div id="universe-particles" aria-hidden="true">
  <canvas id="galaxy-canvas"></canvas>
  <div id="universe-isotipo" aria-hidden="true">
    <div class="isotipo-float">
      <img
        class="isotipo-img"
        src="/images/logos/Isotipo_fadlatam_slow.webp"
        alt=""
        width="572"
        height="628"
        decoding="async"
        draggable="false"
      />
    </div>
  </div>
</div>
<div id="cursor" aria-hidden="true">
  <span class="cursor-ring"></span>
  <span class="cursor-dot"></span>
</div>
<div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>

<header class="site-header" id="site-header">
  <a href="#" class="site-brand">
    <img src="/images/logos/fadlatam_logo_full_1.webp" alt="FAD LATAM" width="200" height="65" decoding="async" />
  </a>
</header>

<div class="scroll-hint" id="scroll-hint" aria-hidden="true">
  <span>scroll</span>
  <span>to explore</span>
  <div class="scroll-hint-line"><i></i></div>
</div>

<div class="kbd-hint" id="kbd-hint">
  <button type="button" class="kbd-hint-btn" id="kbd-hint-btn" aria-expanded="false" aria-controls="kbd-hint-panel" title="Atajos de teclado">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="2" y="6" width="20" height="12" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="kbd-hint-panel" id="kbd-hint-panel" hidden>
    <p class="kbd-hint-title">Atajos de teclado</p>
    <ul>
      <li><span class="kbd-keys"><kbd>↑</kbd><kbd>↓</kbd></span> Navegar secciones</li>
      <li><span class="kbd-keys"><kbd>←</kbd><kbd>→</kbd></span> Anterior / siguiente</li>
      <li><span class="kbd-keys"><kbd>←</kbd><kbd>→</kbd></span> Integra / Industrias: cambiar palabra</li>
    </ul>
  </div>
</div>

<div class="scene-counter" id="scene-counter" aria-hidden="true">
  <span id="scene-current">01</span>
  <span class="scene-counter-sep">/</span>
  <span id="scene-total">{String(SCENE_COUNT).padStart(2, '0')}</span>
</div>

<SideMenu />

<!-- Solo mobile: experiencia bloqueada -->
<div id="mobile-gate" role="dialog" aria-modal="true" aria-labelledby="mobile-gate-title">
  <div class="mobile-gate-inner">
    <p class="mobile-gate-brand">FAD<span>LATAM</span></p>
    <h1 id="mobile-gate-title" class="mobile-gate-title">Experiencia solo en desktop</h1>
    <p class="mobile-gate-msg">
      Esta credencial web está diseñada para verse en computadora.
      Ábrela desde un escritorio para explorar la experiencia completa.
    </p>
  </div>
</div>
